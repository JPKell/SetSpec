{
  "$comment": "setspec model.identity 1.0 — generated from the writer model.",
  "$defs": {
    "WireEnum_IdentityConfidence_": {
      "description": "How firmly an identity pins down a specific set of weights.\n\nStored alongside every measurement. A ``NAME_ONLY`` result carries a permanent caveat: the\nprovider exposed no digest, so it can never be proven later to describe the same weights —\na tag such as ``qwen3.5:latest`` can be repointed at any time. LoadCoach reduces evidence\nconfidence for it and FreeWeight shows it in the UI\n(ADR-0017).",
      "enum": [
        "digest",
        "name_only"
      ],
      "title": "IdentityConfidence",
      "type": "string"
    },
    "WireEnum_ModelCapabilityFlag_": {
      "description": "A capability a provider *claims* a model has, distinct from a measured capability.\n\nFreeWeight's benchmark results record what a model can *demonstrably* do; this flag records\nonly what the provider *says* it can do. The two are never conflated\n(canonical model identity §3).",
      "enum": [
        "tools",
        "vision",
        "thinking",
        "structured_output",
        "embedding"
      ],
      "title": "ModelCapabilityFlag",
      "type": "string"
    },
    "WireEnum_ProviderKind_": {
      "description": "The kind of provider serving a model — not the endpoint it is served from.\n\nKind rather than address, because the same weights served by Ollama and by vLLM behave\ndifferently enough (templating, sampling defaults, KV handling) that their measurements are\nnot interchangeable, while a port or hostname change is a deployment detail that must not\nfragment a model's history.\n\nAdding a member is a backwards-compatible change; renaming one is not, because the value is\npersisted and appears in every canonical ID.",
      "enum": [
        "ollama",
        "openai_compatible",
        "llamacpp",
        "vllm",
        "fake"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "WireSequence_WireEnum_ModelCapabilityFlag__": {
      "items": {
        "$ref": "#/$defs/WireEnum_ModelCapabilityFlag_"
      },
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_parameter_count": {
